{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayuda-venezuela",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Origen del frontend (Cloudflare Pages) permitido por CORS.
    // Para desarrollo local, sobrescribir en .dev.vars (ENVIRONMENT, ALLOWED_ORIGIN).
    "ALLOWED_ORIGIN": "https://unionvzla.com,https://www.unionvzla.com,https://ayuda-venezuela-cpe.pages.dev",
    "EMAIL_FROM": "tramitesgarciamiguel@gmail.com",
    // App ID público de OneSignal (la REST API Key va como secret ONESIGNAL_API_KEY).
    "ONESIGNAL_APP_ID": "aae84b7b-a9bd-4a8e-8c03-7dadc067be66"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ayuda-venezuela",
      "database_id": "129dc6d5-5bf8-40d7-af0f-95f37d26df01",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "7dd24a11c4834044ae50f31bda93cb70"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ayuda-venezuela-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAP_ROOM",
        "class_name": "MapRoom"
      },
      {
        "name": "DELIVERY_ROOM",
        "class_name": "DeliveryRoom"
      },
      {
        "name": "WHATSAPP_QUEUE",
        "class_name": "WhatsAppQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MapRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DeliveryRoom"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["WhatsAppQueue"]
    }
  ],
  "triggers": {
    // Barrido de respaldo: expira necesidades (30 d) y libera compromisos vencidos (12 h).
    "crons": ["*/30 * * * *"]
  }
}
